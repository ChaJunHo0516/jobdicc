// PreBridge 데이터 모델
// 규칙: 회사 내부 데이터(테넌트 데이터)는 모두 companyId 를 가진다.
// JSON 값은 SQLite/PostgreSQL 이식성을 위해 String 으로 저장하고 서버에서 zod 로 검증한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MemberRole {
  COMPANY_ADMIN
  TRAINER
  EMPLOYEE
  PRE_HIRE
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DocumentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum AiArtifactType {
  SUMMARY
  QUIZ
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions         Session[]
  memberships      Membership[]
  applications     JobApplication[]
  companiesCreated Company[]        @relation("CompanyCreator")
}

model Session {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  userId          String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  userAgent       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  status      CompanyStatus @default(PENDING)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy      User                 @relation("CompanyCreator", fields: [createdById], references: [id])
  departments    Department[]
  positionLevels PositionLevel[]
  memberships    Membership[]
  invites        HireInvite[]
  documents      Document[]
  accessRules    DocumentAccessRule[]
  aiArtifacts    AiArtifact[]
  quizzes        Quiz[]
  quizQuestions  QuizQuestion[]
  quizAttempts   QuizAttempt[]
  progress       LearningProgress[]
  jobPostings    JobPosting[]
  applications   JobApplication[]
  auditLogs      AuditLog[]
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     Membership[]
  invites     HireInvite[]
  accessRules DocumentAccessRule[]
  jobPostings JobPosting[]

  @@unique([companyId, name])
  @@unique([companyId, id])
}

model PositionLevel {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rank      Int
  createdAt DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members Membership[]
  invites HireInvite[]

  @@unique([companyId, name])
  @@unique([companyId, id])
}

model Membership {
  id              String       @id @default(cuid())
  companyId       String
  userId          String
  role            MemberRole
  status          MemberStatus @default(ACTIVE)
  departmentId    String?
  positionLevelId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionLevel PositionLevel? @relation(fields: [positionLevelId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
}

// 합격자/직원 인증 초대. 코드는 해시만 저장하며 1회용이다.
model HireInvite {
  id              String     @id @default(cuid())
  companyId       String
  email           String
  codeHash        String     @unique
  role            MemberRole
  departmentId    String?
  positionLevelId String?
  applicationId   String?
  expiresAt       DateTime
  usedAt          DateTime?
  usedById        String?
  revokedAt       DateTime?
  createdById     String
  createdAt       DateTime   @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionLevel PositionLevel? @relation(fields: [positionLevelId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Document {
  id            String         @id @default(cuid())
  companyId     String
  title         String
  description   String         @default("")
  fileKey       String
  originalName  String
  mimeType      String
  size          Int
  extractedText String         @default("")
  status        DocumentStatus @default(PENDING_APPROVAL)
  uploadedById  String
  reviewedById  String?
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accessRules DocumentAccessRule[]
  aiArtifacts AiArtifact[]
  quizzes     Quiz[]
  progress    LearningProgress[]

  @@index([companyId, status])
}

// 규칙이 하나라도 매칭되면 열람 가능. 각 필드가 null 이면 해당 조건은 제한 없음.
model DocumentAccessRule {
  id           String  @id @default(cuid())
  companyId    String
  documentId   String
  departmentId String?
  minRank      Int?
  maxRank      Int?
  roles        String  @default("") // 쉼표 구분 MemberRole 목록, 빈 문자열 = 모든 역할

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([companyId, documentId])
}

model AiArtifact {
  id           String         @id @default(cuid())
  companyId    String
  documentId   String
  type         AiArtifactType
  provider     String
  model        String
  content      String // JSON
  status       ReviewStatus   @default(PENDING_REVIEW)
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  quiz     Quiz?

  @@index([companyId, documentId])
}

model Quiz {
  id           String   @id @default(cuid())
  companyId    String
  documentId   String
  aiArtifactId String?  @unique
  title        String
  passScore    Int      @default(70)
  createdAt    DateTime @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  aiArtifact AiArtifact?    @relation(fields: [aiArtifactId], references: [id], onDelete: SetNull)
  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  @@index([companyId, documentId])
}

model QuizQuestion {
  id          String @id @default(cuid())
  companyId   String
  quizId      String
  order       Int
  prompt      String
  options     String // JSON string[]
  answerIndex Int
  explanation String @default("")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([companyId, quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  companyId   String
  quizId      String
  userId      String
  answers     String // JSON number[]
  score       Int
  passed      Boolean
  submittedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
}

model LearningProgress {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  documentId  String
  viewedAt    DateTime?
  completedAt DateTime?
  bestScore   Int?
  updatedAt   DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, documentId])
}

model JobPosting {
  id             String    @id @default(cuid())
  companyId      String
  title          String
  description    String
  departmentId   String?
  employmentType String
  location       String
  status         JobStatus @default(DRAFT)
  closeAt        DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([companyId, status])
  @@index([status])
}

model JobApplication {
  id            String            @id @default(cuid())
  companyId     String
  jobPostingId  String
  applicantId   String
  coverLetter   String
  status        ApplicationStatus @default(SUBMITTED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant  User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, applicantId])
  @@index([companyId, status])
  @@index([applicantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}
