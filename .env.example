# 복사해서 .env 로 사용하세요. 실제 비밀값은 커밋하지 마세요.
DATABASE_URL="file:./dev.db"
# 32자 이상 임의 문자열 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""
# 업로드 파일 저장 경로 (public 디렉터리 밖)
STORAGE_DIR="./storage/uploads"
# AI 공급자: mock(기본, 외부 호출 없음) | claude(비용 발생 - 사용 전 승인 필요)
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
